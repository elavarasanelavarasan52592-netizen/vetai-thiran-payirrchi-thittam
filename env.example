# Required for Gemini-powered features
GEMINI_API_KEY=your_gemini_api_key_here

# Stable Gemini model; change only if your API account supports another model.
GEMINI_MODEL=gemini-2.5-flash

# Optional local explanation model.
# false keeps installation light and uses Gemini for explanations.
ENABLE_LOCAL_EXPLAINER=false
LOCAL_EXPLAINER_MODEL=MBZUAI/LaMini-Flan-T5-783M
